FROM golang:1.25-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS builder
RUN CGO_ENABLED=0 go install github.com/stripe/smokescreen@v0.1.0

FROM pi-deepseek-sandbox:1.5.0
COPY --from=builder /go/bin/smokescreen /usr/local/bin/smokescreen
COPY egress.cjs /opt/sandbox/egress.cjs
ENTRYPOINT ["node", "/opt/sandbox/egress.cjs"]
